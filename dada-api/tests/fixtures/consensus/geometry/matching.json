{
  "box_cases": [
    {
      "name": "same_object_two_raters",
      "threshold": 0.5,
      "objects": [
        [
          [10, 10, 20, 20]
        ],
        [
          [11, 11, 20, 20]
        ]
      ],
      "expected": {
        "groups": [
          {
            "members": [
              [0, 0],
              [1, 0]
            ],
            "ambiguous": false
          }
        ],
        "duplicates": []
      }
    },
