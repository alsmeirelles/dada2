DADA_ENVIRONMENT=development
DADA_LOG_LEVEL=INFO
DADA_CORS_ORIGINS=http://localhost:5173
DADA_JWT_SECRET_KEY=change-this-development-secret
DADA_JWT_ALGORITHM=HS256
DADA_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh credentials. Keep DADA_REFRESH_COOKIE_SECURE=true everywhere the App
# is served over HTTPS; set it to false only for plain-HTTP local development.
DADA_REFRESH_TOKEN_EXPIRE_DAYS=14
DADA_REFRESH_COOKIE_SECURE=true
DADA_REFRESH_COOKIE_SAMESITE=lax

# Read by `dada-api bootstrap-admin`. Leave any of them unset to be prompted.
DADA_SEED_ADMIN_USERNAME=admin
DADA_SEED_ADMIN_DISPLAY_NAME=DADA Administrator
DADA_SEED_ADMIN_PASSWORD=change-this-admin-password
DADA_SEED_SERVICE_USERNAME=dada
DADA_SEED_SERVICE_PASSWORD=change-this-service-password

DADA_POSTGRES_CONTAINER_NAME=dada-postgres
DADA_POSTGRES_HOST=localhost
DADA_POSTGRES_HOST_PORT=5432
DADA_POSTGRES_CONTAINER_PORT=5432
DADA_POSTGRES_USER=dada
DADA_POSTGRES_PASSWORD=dada-development-only
DADA_POSTGRES_DB=dada
DADA_DATABASE_URL=postgresql+asyncpg://dada:dada-development-only@localhost:5432/dada

DADA_REDIS_HOST_PORT=6379
DADA_REDIS_URL=redis://localhost:6379/0

DADA_SUPPORTED_IMAGE_MEDIA_TYPES=image/jpeg,image/png,image/webp
DADA_MAX_FILE_BYTES=104857600
DADA_MAX_PROJECT_FILES=100000
DADA_UPLOAD_CHUNK_BYTES=8388608
DADA_UPLOAD_SESSION_TTL_HOURS=24
DADA_REALTIME_TRANSPORT=websocket

# Storage roots. Relative values resolve against the dada-api directory.
# They must differ: cancelling an upload purges the parts root outright, and
# promoted media must never sit inside that blast radius.
DADA_MEDIA_ROOT=var/media
DADA_UPLOAD_PARTS_ROOT=var/upload-parts

DADA_API_HOST=0.0.0.0
DADA_API_PORT=8000
