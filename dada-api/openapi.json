{
  "components": {
    "schemas": {
      "AnnotationSubmitRequest": {
        "description": "COCO-style annotation submission payload.",
        "properties": {
          "annotations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Annotations",
            "type": "array"
          },
          "image_id": {
            "minLength": 1,
            "title": "Image Id",
            "type": "string"
          }
        },
        "required": [
          "image_id",
          "annotations"
        ],
        "title": "AnnotationSubmitRequest",
        "type": "object"
      },
      "AnnotationSubmitResponse": {
        "description": "Annotation submission result.",
        "properties": {
          "accepted_annotations": {
            "title": "Accepted Annotations",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "accepted_annotations"
        ],
        "title": "AnnotationSubmitResponse",
        "type": "object"
      },
      "CapabilitiesResponse": {
        "description": "Limits and features that clients must discover at runtime.",
        "properties": {
          "max_file_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Max File Bytes",
            "type": "integer"
          },
          "max_project_files": {
            "exclusiveMinimum": 0.0,
            "title": "Max Project Files",
            "type": "integer"
          },
          "realtime_transport": {
            "enum": [
              "websocket",
              "polling"
            ],
            "title": "Realtime Transport",
            "type": "string"
          },
          "supported_image_media_types": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Supported Image Media Types",
            "type": "array"
          },
          "supported_task_types": {
            "items": {
              "enum": [
                "classification",
                "detection",
                "segmentation"
              ],
              "type": "string"
            },
            "title": "Supported Task Types",
            "type": "array"
          },
          "upload_chunk_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Upload Chunk Bytes",
            "type": "integer"
          }
        },
        "required": [
          "supported_image_media_types",
          "max_file_bytes",
          "max_project_files",
          "upload_chunk_bytes",
          "supported_task_types",
          "realtime_transport"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "DependencyStatus": {
        "description": "Readiness state for one external dependency.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Stable machine- and human-readable error details.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "trace_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Envelope used for all API application errors.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthResponse": {
        "description": "API health response.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "JSON login payload.",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ProjectCreate": {
        "description": "Create-project request contract.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "initial_training_size": {
            "minimum": 1.0,
            "title": "Initial Training Size",
            "type": "integer"
          },
          "iteration_batch_size": {
            "minimum": 1.0,
            "title": "Iteration Batch Size",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "task_type": {
            "enum": [
              "classification",
              "detection",
              "segmentation"
            ],
            "title": "Task Type",
            "type": "string"
          },
          "test_set_size": {
            "minimum": 1.0,
            "title": "Test Set Size",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "task_type",
          "initial_training_size",
          "test_set_size",
          "iteration_batch_size"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectPage": {
        "description": "Cursor-paginated project collection.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "ProjectPage",
        "type": "object"
      },
      "ProjectResponse": {
        "description": "Project representation expected by the App.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "initial_training_size": {
            "title": "Initial Training Size",
            "type": "integer"
          },
          "iteration_batch_size": {
            "title": "Iteration Batch Size",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "ingesting",
              "ready",
              "active",
              "training",
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "task_type": {
            "enum": [
              "classification",
              "detection",
              "segmentation"
            ],
            "title": "Task Type",
            "type": "string"
          },
          "test_set_size": {
            "title": "Test Set Size",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "task_type",
          "status",
          "owner_id",
          "initial_training_size",
          "test_set_size",
          "iteration_batch_size",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectResponse",
        "type": "object"
      },
      "QueueItemResponse": {
        "description": "Image assignment returned by the annotation queue.",
        "properties": {
          "image_id": {
            "title": "Image Id",
            "type": "string"
          },
          "image_url": {
            "title": "Image Url",
            "type": "string"
          },
          "lease_expires_in_seconds": {
            "title": "Lease Expires In Seconds",
            "type": "integer"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          }
        },
        "required": [
          "image_id",
          "image_url",
          "lease_expires_in_seconds"
        ],
        "title": "QueueItemResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Aggregate dependency and migration readiness state.",
        "properties": {
          "dependencies": {
