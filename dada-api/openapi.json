            "type": "object"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SamPredictRequest": {
        "description": "SAM prediction request.",
        "properties": {
          "image_id": {
            "minLength": 1,
            "title": "Image Id",
            "type": "string"
          },
          "prompts": {
            "items": {
              "$ref": "#/components/schemas/SamPrompt"
            },
            "minItems": 1,
            "title": "Prompts",
            "type": "array"
          }
        },
        "required": [
          "image_id",
          "prompts"
        ],
        "title": "SamPredictRequest",
        "type": "object"
      },
      "SamPredictResponse": {
        "description": "SAM prediction response.",
        "properties": {
          "embedding_cache_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Cache Key"
          },
          "image_id": {
            "title": "Image Id",
            "type": "string"
          },
          "polygons": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Polygons",
            "type": "array"
          }
        },
        "required": [
          "image_id",
          "polygons"
        ],
        "title": "SamPredictResponse",
        "type": "object"
      },
      "SamPrompt": {
        "description": "Prompt sent to the assisted segmentation endpoint.",
        "properties": {
          "coordinates": {
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "title": "Coordinates",
            "type": "array"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "type": {
            "enum": [
              "point",
              "box"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "SamPrompt",
        "type": "object"
      },
      "TokenResponse": {
        "description": "Bearer token response.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserCreate": {
        "description": "Admin request to create a user.",
        "properties": {
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "default": "annotator"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "display_name",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserRead": {
        "description": "Public user representation.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "is_active",
          "created_at"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "UserRole": {
        "description": "Supported DADA API roles.",
        "enum": [
          "annotator",
          "admin"
        ],
        "title": "UserRole",
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
